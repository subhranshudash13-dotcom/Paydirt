# ── Paydirt environment ────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# Postgres (Tiger Data / Timescale + pgvector via docker-compose)
DATABASE_URL=postgres://ledger:ledger@localhost:5432/quarry

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=paydirt

# Ollama (local, open-weight) — code/notes never leave your machine
OLLAMA_URL=http://localhost:11434
GEMMA_CHAT_MODEL=gemma3:4b
GEMMA_EMBED_MODEL=embeddinggemma

# Integrations (leave blank to run in offline/demo mode)
GITHUB_TOKEN=
SERPAPI_KEY=
TABPFN_TOKEN=

# Prediction sidecar
PREDICTOR_URL=http://localhost:8000

# Observability
SENTRY_DSN=

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Safety: nothing writes to GitHub unless DRY_RUN=false AND the user approves
DRY_RUN=true
