{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "bindings": [
        {
          "type": "service",
          "service": "predictor",
          "format": "url",
          "env": "PREDICTOR_URL"
        }
      ]
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "predictor": {
      "root": "services/predictor",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
